{
  "expo": {
    "name": "withcam",
    "slug": "withcam",
    "scheme": "withcam",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F1EA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.withcam.app",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSCameraUsageDescription": "withcam records photos and videos for your hourly posts.",
        "NSPhotoLibraryUsageDescription": "withcam accesses your library to upload profile photos and stories.",
        "NSPhotoLibraryAddUsageDescription": "withcam saves recap videos to your photo library.",
        "NSMicrophoneUsageDescription": "withcam uses the microphone while recording videos."
      }
    },
    "android": {
      "package": "com.withcam.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F1EA"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-camera",
      "expo-image-picker",
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "edc1d095-2764-4da9-a7db-d0026312eb8a"
      }
    },
    "owner": "gimgibae2"
  }
}
